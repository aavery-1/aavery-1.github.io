# Copy this file to .env and fill in your own values. .env is gitignored and
# must never be committed or deployed.

# ── Client-side (browser) key ────────────────────────────────────────────────
# Read at build time by Vite and INLINED INTO THE CLIENT BUNDLE, so it is
# publicly visible to anyone who loads the site. This is expected for the Maps
# JavaScript SDK. Restrict it in the Google Cloud console by HTTP referrer (your
# domain only) and by API (Maps JavaScript API only) before shipping.
# Never place a non-public secret behind a VITE_ prefix.
VITE_GOOGLE_MAPS_API_KEY=

# ── Supabase access gate (public values, safe to ship) ───────────────────────
# The URL and anon key of your Supabase project. These are meant to be public;
# your data is protected by row-level security, not by hiding the anon key. The
# access PASSWORD is never here: it is stored as a hash inside Supabase and
# checked by the check_access() database function. If BOTH are blank the app runs
# with no password gate (handy for local development). See the setup steps.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Build-time-only secret (never shipped to the browser) ────────────────────
# Used ONLY by the Node data-prep scripts in scripts/ (npm run data:*) to fetch
# from the U.S. Census API and generate static files in public/data/. It is not
# VITE_-prefixed, so Vite never inlines it into client code, and it never leaves
# your machine / CI. Request a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
