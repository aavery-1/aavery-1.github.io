{
  "name": "fl-school-facilities-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Internal analyst tool for exploring school-facilities data across Miami-Dade, Broward, and Orange counties. Shows facts on a map. Never scores or ranks.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "data:layers": "node --env-file=.env scripts/fetch-real-layers.mjs",
    "data:schools": "node scripts/fetch-real-data.mjs",
    "data:plp": "node scripts/parse-plp.mjs",
    "data:poppoints": "node --env-file=.env scripts/build-population-points.mjs",
    "data:fish": "node scripts/parse-fish-capacity.mjs",
    "data:charters": "node scripts/reconcile-charters.mjs",
    "data:legislators": "node scripts/parse-legislators.mjs",
    "data:board": "node scripts/fetch-board-districts.mjs",
    "data:orangeboard": "node scripts/parse-orange-board.mjs",
    "data:titlei": "python3 scripts/parse-title-i-tipa.py",
    "data:titlei:ccd": "node scripts/fetch-title-i.mjs",
    "data:frl": "python3 scripts/parse-frl-lunch.py",
    "data:tenthday": "python3 scripts/parse-broward-tenthday.py",
    "data:income": "node --env-file=.env scripts/build-acs-income.mjs",
    "data:demographics": "node --env-file=.env scripts/build-school-demographics.mjs",
    "data:soh": "node scripts/build-schools-of-hope.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.87.0",
    "@carbon/react": "^1.115.0",
    "@deck.gl/core": "^9.0.38",
    "@deck.gl/google-maps": "^9.0.38",
    "@deck.gl/layers": "^9.0.38",
    "@tanstack/react-virtual": "^3.14.11",
    "@turf/turf": "^7.1.0",
    "fflate": "^0.8.3",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "sass": "^1.108.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
